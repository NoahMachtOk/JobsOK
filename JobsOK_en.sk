options:
	p: <##18969B>&lJOBS &8→&7
	jobgui: <##18969B>&lJOBS &8→ &0Menu

function jobgui(t: player):
	set {_jobs} to a new chest inventory with 4 row named "{@jobgui}"
	set {_fill} to black stained glass pane without entire tooltip
	loop all integers between 0 and 35:
		set slot loop-integer of {_jobs} to {_fill}
	set slot 4 of {_jobs} to skull of {_t} named "&8• {@p} &7Statistiken" with lore "&f" and "&8➥ &7Prestiges: &e%{jobs::%{_t}%::prestigecount}%"
	set slot 10 of {_jobs} to iron pickaxe named "{@p} <#24E1E9>Miner-Job" with lore "&f" and "&8→ <#24E1E9>Break ores for this job" and "&8➥ &7Level: <#24E1E9>%{jobs::%{_t}%::miner::level}%" and "&8➥ &7Experience: <#24E1E9>%{jobs::%{_t}%::miner::exp}%&8/<#13EE57>%{jobs::%{_t}%::miner::nextmax}%" and "&8➥ &7Prestige: <#24E1E9>%{jobs::%{_t}%::miner::prestige}%" and "&f" and "&8➥ %{jobs::%{_t}%::miner::canprestige}%"
	set slot 12 of {_jobs} to zombie head named "{@p} <#C63C19>Fighter-Job" with lore "&f" and "&8→ <#C63C19>Kill mobs for this job" and "&8➥ &7Level: <#C63C19>%{jobs::%{_t}%::fighter::level}%" and "&8➥ &7Experience: <#C63C19>%{jobs::%{_t}%::fighter::exp}%&8/<#13EE57>%{jobs::%{_t}%::fighter::nextmax}%" and "&8➥ &7Prestige: <#C63C19>%{jobs::%{_t}%::fighter::prestige}%" and "&f" and "&8➥ %{jobs::%{_t}%::fighter::canprestige}%"
	set slot 14 of {_jobs} to brush named "{@p} <#EEB828>Digger-Job" with lore "&f" and "&8→ <#EEB828>Break sand(-related) blocks for this job" and "&8➥ &7Level: <#EEB828>%{jobs::%{_t}%::shovel::level}%" and "&8➥ &7Experience: <#EEB828>%{jobs::%{_t}%::shovel::exp}%&8/<#13EE57>%{jobs::%{_t}%::shovel::nextmax}%" and "&8➥ &7Prestige: <#EEB828>%{jobs::%{_t}%::shovel::prestige}%" and "&f" and "&8➥ %{jobs::%{_t}%::shovel::canprestige}%"
	set slot 16 of {_jobs} to oak log named "{@p} <#EE8919>Timberjack-Job" with lore "&f" and "&8→ <#EE8919>Break wood for this job" and "&8➥ &7Level: <#EEB828>%{jobs::%{_t}%::timber::level}%" and "&8➥ &7Experience: <#EEB828>%{jobs::%{_t}%::timber::exp}%&8/<#13EE57>%{jobs::%{_t}%::timber::nextmax}%" and "&8➥ &7Prestige: <#EEB828>%{jobs::%{_t}%::timber::prestige}%" and "&f" and "&8➥ %{jobs::%{_t}%::timber::canprestige}%"
	set slot 20 of {_jobs} to spyglass named "{@p} <#19EEB2>Tourist-Job" with lore "&f" and "&8→ <#19EEB2>Walk through the world for this job" and "&8➥ &7Level: <#19EEB2>%{jobs::%{_t}%::tourist::level}%" and "&8➥ &7Experience: <#19EEB2>%{jobs::%{_t}%::tourist::exp}%&8/<#13EE57>%{jobs::%{_t}%::tourist::nextmax}%" and "&8➥ &7Prestige: <#19EEB2>%{jobs::%{_t}%::tourist::prestige}%" and "&f" and "&8➥ %{jobs::%{_t}%::tourist::canprestige}%"
	set slot 22 of {_jobs} to fishing rod named "{@p} <#1964EE>Fisherman-Job" with lore "&f" and "&8→ <#1964EE>Fish in the water for this job" and "&8➥ &7Level: <#1964EE>%{jobs::%{_t}%::fisher::level}%" and "&8➥ &7Experience: <#1964EE>%{jobs::%{_t}%::fisher::exp}%&8/<#1964EE>%{jobs::%{_t}%::fisher::nextmax}%" and "&8➥ &7Prestige: <#1964EE>%{jobs::%{_t}%::fisher::prestige}%" and "&f" and "&8➥ %{jobs::%{_t}%::fisher::canprestige}%"
	set slot 24 of {_jobs} to diamond hoe named "{@p} <#F3BE0E>Farmer-Job" with lore "&f" and "&8→ <#F3BE0E>Break crops for this job" and "&8➥ &7Level: <#F3BE0E>%{jobs::%{_t}%::farmer::level}%" and "&8➥ &7Experience: <#F3BE0E>%{jobs::%{_t}%::farmer::exp}%&8/<#F3BE0E>%{jobs::%{_t}%::farmer::nextmax}%" and "&8➥ &7Prestige: <#F3BE0E>%{jobs::%{_t}%::farmer::prestige}%" and "&f" and "&8➥ %{jobs::%{_t}%::farmer::canprestige}%"

	open {_jobs} to {_t}
	


function checklevelup(t: player, j: text):
	{jobs::%{_t}%::%{_j}%::exp} >= {jobs::%{_t}%::%{_j}%::nextmax}:
		remove {jobs::%{_t}%::%{_j}%::nextmax} from {jobs::%{_t}%::%{_j}%::exp}
		set {jobs::%{_t}%::%{_j}%::lastmax} to {jobs::%{_t}%::%{_j}%::nextmax} 
		set {jobs::%{_t}%::%{_j}%::nextmax} to ({jobs::%{_t}%::%{_j}%::lastmax} + ({jobs::%{_t}%::%{_j}%::lastmax} / 100) * 20)   
		add 1 to {jobs::%{_t}%::%{_j}%::level} 
		add 0.05 to {jobs::%{_t}%::%{_j}%::eventmoney} 
		add 0.05 to {jobs::%{_t}%::%{_j}%::eventexp}
		send "{@p} &7You're now level &e%{jobs::%{_t}%::%{_j}%::level}% &7in the job <#13EE57>%uppercase {_j}%" to {_t}
		{jobs::%{_t}%::%{_j}%::level} >= 100:
			set {jobs::%{_t}%::%{_j}%::canprestige} to "&7You can <#13EE57>prestige&7! &8(&eClick here&8)"
			send "{@p} &7You can prestige in the job %uppercase {_j}% &7! &8(&e/jobs&8)" to {_t}

command /jobs:
	aliases: jobmenu, jobs:jobs, jobs:jobmenu 
	usage: {@p} &7Syntax: &e/jobs 
	trigger:
		jobgui(player)

on join:		
	
	{jobs::%player%::miner::level} is not set:
		set {jobs::%player%::miner::level} to 0 
		set {jobs::%player%::miner::exp} to 0
		set {jobs::%player%::miner::nextmax} to 1000
		set {jobs::%player%::miner::prestige} to 0 
		set {jobs::%player%::miner::canprestige} to "&7You <#E01414>can't prestige"
		set {jobs::%player%::miner::eventmoney} to 0.20
		set {jobs::%player%::miner::eventexp} to 0.20
	
	{jobs::%player%::fighter::*} is not set:
		set {jobs::%player%::fighter::level} to 0 
